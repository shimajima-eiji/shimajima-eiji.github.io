BEGIN:VEVENT
UID:https://ospn.connpass.com/event/398565/?utm_campaign=series_events&utm_
 source=feed&utm_medium=atom
DTSTAMP:20261026T042616Z
DTSTART;TZID=Asia/Tokyo:20261122T104500
